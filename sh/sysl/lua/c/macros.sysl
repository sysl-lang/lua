// The function-like macros of `lua.h` and `lauxlib.h`, each written as the header's expansion.
//
// A macro has no symbol, so nothing here is an `extern`; each body is the macro's right-hand side
// with C's operators spelled sysl's way. Two have no function form at all:
//
// - **`lua_pushliteral(L, "s")`** pastes `""` in front of a literal so that only a literal is
//   accepted. Its expansion is `lua_pushstring`, which takes the C string a literal already is.
// - **`luaL_newlib(L, l)` and `luaL_newlibtable`** take `sizeof(l)/sizeof((l)[0]) - 1` of a C
//   array. The count is the caller's: `lua_createtable(L, 0, n)` then `luaL_setfuncs(L, l, 0)`.
//
// `luaL_checkversion` is here; `luaL_argcheck`/`luaL_argexpected` are an `if` around
// `luaL_argerror`/`luaL_typeerror` and read better written out at the call.

module sh.sysl.lua.c

import sysl.raw.ptr_cast

// ## lua.h

lua_upvalueindex(i: int) -> int = LUA_REGISTRYINDEX - i

lua_call(L: *State, n: int, r: int) = lua_callk(L, n, r, 0, null)

lua_pcall(L: *State, n: int, r: int, f: int) -> int = lua_pcallk(L, n, r, f, 0, null)

lua_yield(L: *State, n: int) -> int = lua_yieldk(L, n, 0, null)

lua_getextraspace(L: *State) -> *u8 = ptr_cast(usize(L) - LUA_EXTRASPACE)

lua_tonumber(L: *State, i: int) -> Number = lua_tonumberx(L, i, null)

lua_tointeger(L: *State, i: int) -> Integer = lua_tointegerx(L, i, null)

lua_pop(L: *State, n: int) = lua_settop(L, -n - 1)

lua_newtable(L: *State) = lua_createtable(L, 0, 0)

lua_register(L: *State, n: *u8, f: CFunction)
    lua_pushcfunction(L, f)
    lua_setglobal(L, n)

lua_pushcfunction(L: *State, f: CFunction) = lua_pushcclosure(L, f, 0)

lua_isfunction(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TFUNCTION
lua_istable(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TTABLE
lua_islightuserdata(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TLIGHTUSERDATA
lua_isnil(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TNIL
lua_isboolean(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TBOOLEAN
lua_isthread(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TTHREAD
lua_isnone(L: *State, n: int) -> bool = lua_type(L, n) == LUA_TNONE
lua_isnoneornil(L: *State, n: int) -> bool = lua_type(L, n) <= 0

lua_pushglobaltable(L: *State)
    lua_rawgeti(L, LUA_REGISTRYINDEX, LUA_RIDX_GLOBALS)

lua_tostring(L: *State, i: int) -> *u8 = lua_tolstring(L, i, null)

lua_insert(L: *State, idx: int) = lua_rotate(L, idx, 1)

lua_remove(L: *State, idx: int)
    lua_rotate(L, idx, -1)
    lua_pop(L, 1)

lua_replace(L: *State, idx: int)
    lua_copy(L, -1, idx)
    lua_pop(L, 1)

lua_newuserdata(L: *State, s: usize) -> *u8 = lua_newuserdatauv(L, s, 1)
lua_getuservalue(L: *State, idx: int) -> int = lua_getiuservalue(L, idx, 1)
lua_setuservalue(L: *State, idx: int) -> int = lua_setiuservalue(L, idx, 1)

// ## lauxlib.h

luaL_checkversion(L: *State) = luaL_checkversion_(L, Number(LUA_VERSION_NUM), LUAL_NUMSIZES)

luaL_checkstring(L: *State, n: int) -> *u8 = luaL_checklstring(L, n, null)
luaL_optstring(L: *State, n: int, d: *u8) -> *u8 = luaL_optlstring(L, n, d, null)
luaL_typename(L: *State, i: int) -> *u8 = lua_typename(L, lua_type(L, i))

luaL_dofile(L: *State, f: *u8) -> bool = luaL_loadfile(L, f) != 0 || lua_pcall(L, 0, LUA_MULTRET, 0) != 0
luaL_dostring(L: *State, s: *u8) -> bool = luaL_loadstring(L, s) != 0 || lua_pcall(L, 0, LUA_MULTRET, 0) != 0

luaL_getmetatable(L: *State, n: *u8) -> int = lua_getfield(L, LUA_REGISTRYINDEX, n)

luaL_loadfile(L: *State, f: *u8) -> int = luaL_loadfilex(L, f, null)
luaL_loadbuffer(L: *State, s: *u8, sz: usize, n: *u8) -> int = luaL_loadbufferx(L, s, sz, n, null)

luaL_pushfail(L: *State) = lua_pushnil(L)

luaL_bufflen(B: *Buffer) -> usize = (*B).n
luaL_buffaddr(B: *Buffer) -> *u8 = (*B).b

luaL_addchar(B: *Buffer, ch: u8)
    if (*B).n >= (*B).size then luaL_prepbuffsize(B, 1)
    (*B).b[(*B).n] = ch
    (*B).n += 1

luaL_addsize(B: *Buffer, s: usize) = (*B).n += s
luaL_buffsub(B: *Buffer, s: usize) = (*B).n -= s

luaL_prepbuffer(B: *Buffer) -> *u8 = luaL_prepbuffsize(B, LUAL_BUFFERSIZE)
