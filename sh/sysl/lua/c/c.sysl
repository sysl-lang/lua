extern luaL_where(L: *State, lvl: int)

extern luaL_error(L: *State, fmt: *u8, ...) -> never

extern luaL_checkoption(L: *State, arg: int, def: *u8, lst: **u8) -> int
extern luaL_fileresult(L: *State, stat: int, fname: *u8) -> int
