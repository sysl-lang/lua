extern luaL_loadfilex(L: *State, filename: *u8, mode: *u8) -> int
extern luaL_loadbufferx(L: *State, buff: *u8, sz: usize, name: *u8, mode: *u8) -> int
extern luaL_loadstring(L: *State, s: *u8) -> int
extern luaL_newstate() -> *State
extern luaL_len(L: *State, idx: int) -> Integer
extern luaL_addgsub(b: *Buffer, s: *u8, p: *u8, r: *u8)
extern luaL_gsub(L: *State, s: *u8, p: *u8, r: *u8) -> *u8
extern luaL_setfuncs(L: *State, l: *Reg, nup: int)
extern luaL_getsubtable(L: *State, idx: int, fname: *u8) -> int
extern luaL_traceback(L: *State, L1: *State, msg: *u8, level: int)
extern luaL_requiref(L: *State, modname: *u8, openf: CFunction, glb: int)

extern luaL_buffinit(L: *State, B: *Buffer)
extern luaL_prepbuffsize(B: *Buffer, sz: usize) -> *u8
extern luaL_addlstring(B: *Buffer, s: *u8, l: usize)
